{
    "swagger": "2.0",
    "info": {
        "description": "Данный сервис принимает запросы на добавление числа и возвращает отсортированный список чисел",
        "title": "Сервис для тестового задания",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/v1",
    "paths": {
        "/num": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "API"
                ],
                "summary": "Добавление чисел",
                "parameters": [
                    {
                        "description": "Структура добавления числа",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.AddNumRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/numerator.successResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "body": {
                                            "$ref": "#/definitions/http.NumResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/numerator.failResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/numerator.failResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.AddNumRequest": {
            "type": "object",
            "properties": {
                "num": {
                    "type": "integer"
                }
            }
        },
        "http.NumResponse": {
            "type": "object",
            "properties": {
                "nums": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "numerator.failResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "numerator.successResponse": {
            "type": "object",
            "properties": {
                "body": {},
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        }
    }
}